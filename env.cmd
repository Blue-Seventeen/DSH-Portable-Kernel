@echo off
rem --- Hack3rX-Harness portable environment (all paths relative to this folder) ---
rem Keep this file pure ASCII (cmd.exe parses it with the OEM code page).
rem
rem Do not inherit a host DSH session. If this folder is started from inside another dsh
rem (or from a shell that exports dsh vars), things like DSH_HOME / DSH_SESSION_ID would
rem point back at the host - the portable copy would write into the host profile, and the
rem desktop app would attach to the host session instead of its own. Switch off the ones
rem we know about; our own DSH_PORTABLE_* switches are left alone on purpose.
for %%V in (DSH_HOME DSH_AGENTS_HOME DSH_PROFILE DSH_SESSION_ID DSH_WORKSPACE DSH_STORAGE DSH_CONFIG DSH_LOG_LEVEL DSH_DEBUG DSH_NO_UPDATE_CHECK DSH_PERMISSION_MODE DSH_FS_PROFILE DSH_FS_FORMAT DSH_FS_DRIVE DSH_PNPM_IMPORT_METHOD DSH_PNPM_STORE DSH_STAGE) do set "%%V="
rem prevent Electron being mistaken for node when launched from inside a dsh session
set "ELECTRON_RUN_AS_NODE="
set "DSH_HOME=%ROOT%home"
set "DSH_AGENTS_HOME=%ROOT%agents"
set "npm_config_cache=%ROOT%cache\npm"
set "npm_config_userconfig=%ROOT%cache\npmrc"
rem Everything the shell writes stays inside this folder: portability first.
rem (the old layout kept the pnpm store under the host profile; that is gone for good.)
set "DSH_PNPM_STORE=%ROOT%cache\pnpm-store"
set "npm_config_store_dir=%DSH_PNPM_STORE%"
set "PNPM_HOME=%ROOT%cache\pnpm-home"
rem short-prefix staging for app/plugin installs (still inside the folder)
set "DSH_STAGE=%ROOT%tmp\build"
set "TMP=%ROOT%tmp"
set "TEMP=%ROOT%tmp"
if not exist "%ROOT%tmp" mkdir "%ROOT%tmp" >nul 2>nul
rem --- filesystem profile ---------------------------------------------------------
rem NTFS/ReFS -> native (official workspace-write sandbox, default pnpm import method)
rem anything else (exFAT/FAT32/UNC) -> compat (no ACL sandbox, pnpm imports by copy)
rem The fragment is generated by tools\fs-profile.ps1 and reused until the drive changes.
set "FSDRV="
set "FSSER="
if exist "%ROOT%tmp\fs-drive.txt" for /f "usebackq tokens=1,2 delims=|" %%A in ("%ROOT%tmp\fs-drive.txt") do (set "FSDRV=%%A" & set "FSSER=%%B")
if not exist "%ROOT%tmp\fs-profile.cmd" goto dsh_fs_need_detect
if /i not "%FSDRV%"=="%ROOT:~0,1%" goto dsh_fs_need_detect
rem ????????????/??????????????????????????????
set "CURSER="
if "%ROOT:~1,1%"==":" for /f "tokens=5" %%S in ('fsutil fsinfo volumeinfo "%ROOT:~0,1%:" 2^>nul ^| findstr /i "Serial"') do set "CURSER=%%S"
if defined FSSER if defined CURSER if /i not "%FSSER%"=="%CURSER%" goto dsh_fs_need_detect
goto dsh_fs_load
:dsh_fs_need_detect
call :dsh_fs_detect
:dsh_fs_load
if exist "%ROOT%tmp\fs-profile.cmd" call "%ROOT%tmp\fs-profile.cmd"
if not defined DSH_FS_PROFILE set "DSH_FS_PROFILE=compat"
if not defined DSH_PERMISSION_MODE set "DSH_PERMISSION_MODE=danger-full-access"
if not defined DSH_PNPM_IMPORT_METHOD set "DSH_PNPM_IMPORT_METHOD=copy"
rem only prepend once: every start-*.cmd calls this file again, and repeated prepends
rem would grow PATH until it hits the 8191-character limit
if not defined DSH_PORTABLE_PATH_DONE set "PATH=%ROOT%runtime\node\bin;%ROOT%runtime\pnpm\bin;%ROOT%runtime\vcredist;%PATH%"
set "DSH_PORTABLE_PATH_DONE=1"
goto :eof

:dsh_fs_detect
rem no PowerShell (very old or trimmed Windows): fall back to compat, retry next launch
if not exist "%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" goto :eof
powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File "%ROOT%tools\fs-profile.ps1" -Root "%ROOT%." -Quiet >nul 2>nul
if not exist "%ROOT%tmp\fs-profile.cmd" del "%ROOT%tmp\fs-drive.txt" >nul 2>nul
goto :eof